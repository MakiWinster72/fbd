OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_KEEP_ALIVE=0

MINERU_BASE_URL=http://127.0.0.1:7860
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge_chunks_v1
MILVUS_VECTOR_DIM=4096
NO_PROXY=localhost,127.0.0.1

RAG_DATA_DIR=./data
RAG_CHUNK_TARGET_CHARS=800
RAG_CHUNK_MAX_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=120
RAG_RETRIEVAL_TOP_K=6
# 启用重排序时先从 Milvus 召回的候选数量
RAG_RETRIEVAL_CANDIDATE_K=20
RAG_RETRIEVAL_MIN_SCORE=0.35

# 多用户认证与管理员模型配置
# 本地开发未设置 DATABASE_URL 时继续使用 SQLite；生产环境改为 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://knowledge_rag:replace-password@127.0.0.1:5432/knowledge_rag
DATABASE_URL=
RAG_APP_DB_PATH=./data/app.db
RAG_AUTH_REQUIRED=true
RAG_AUTH_SESSION_HOURS=24
RAG_AUTH_COOKIE_SECURE=false
# 使用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成并妥善保管
RAG_MODEL_SECRET_KEY=replace-with-a-long-random-secret
# 可选：仅在用户表为空时创建一次初始管理员；也可运行 knowledge-rag create-admin
RAG_BOOTSTRAP_ADMIN_USERNAME=
RAG_BOOTSTRAP_ADMIN_PASSWORD=
